from tkinter import *
import requests

URL = "https://api.openweathermap.org/data/2.5/weather"
API_KEY = "ecb6e3648f0b6f3b680cdc2e67887de9"

window = Tk()

window.geometry("400x600")
window.title("Weather App")
window.config(bg = "#133463")

headerFrame = Frame(window, bg = "#0D2242")
headerFrame.pack(side = TOP, fill = X)

footerFrame = Frame(window, bg = "#0D2242")
footerFrame.pack(side = BOTTOM, fill = X)

inputFrame = Frame(window, bg = "#255394")
inputFrame.pack(side = TOP, fill = BOTH, expand = True)

infoFrame = Frame(window, bg = "#1E4377")
infoFrame.pack(side = TOP, fill = BOTH, expand = True)

titleLabel = Label(headerFrame, text = "WEATHERCAST APP", font = ("Arial", 22), bg = "#0D2242", fg = "White")
titleLabel.pack(pady = 20)

footerLabel = Label(footerFrame, text = "By Kinjal Priyadarshini", font = ("Arial", 16), bg = "#0D2242", fg = "White")
footerLabel.pack(pady = 10) 

input = Entry(inputFrame, text = "City name", font = ("Arial", 16), bg = "#A7A8AA", fg = "White", justify = "center")
input.pack(pady = (35, 10)) 

def findWeatherInfo():
    city = input.get().strip().lower()
    parameters = {
        "q": city, 
        "appid": API_KEY
    }
    response = requests.get(url = URL, params = parameters)
    data = response.json()
    print(data)

#http: supports get, post, put, delete

submit = Button(inputFrame, text = "Submit", font = ("Arial", 16), bg = "#0D2242", fg = "White", command = findWeatherInfo)
submit.pack(pady = 10) 

